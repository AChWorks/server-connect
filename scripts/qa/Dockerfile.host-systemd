# Ephemeral GitHub-hosted QA only. Not a production container or supported install target.
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git gzip openssl iproute2 nftables openssh-client openssh-server passwd procps \
      python3 strace systemd systemd-sysv tar util-linux \
      php8.4-cli php8.4-fpm php8.4-curl php8.4-sqlite3 php8.4-xml \
      libfcgi-bin unzip \
 && rm -rf /var/lib/apt/lists/*
# No unrelated global PHP-FPM service should auto-start in the QA systemd guest.
RUN rm -f /etc/systemd/system/multi-user.target.wants/php8.4-fpm.service
# Fixture-only upstream bytes, fetched while building on a connected disposable
# CI runner and checksum-pinned BEFORE the runtime guest is disconnected.
RUN set -eu; \
    mkdir -p /opt/sc-qa-wordpress-core /tmp/sc-qa-wp; \
    curl -q --fail --location --proto '=https' --proto-redir '=https' \
      --retry 2 --connect-timeout 15 --max-time 150 --silent --show-error \
      -o /tmp/sc-qa-wp/core.tar.gz https://wordpress.org/wordpress-7.1.3.tar.gz; \
    echo 'd2a09acb6a15e3b9c471d72557753c266d6f41a79ed19bfe04cbfe49e283b2a5  /tmp/sc-qa-wp/core.tar.gz' | sha256sum --check; \
    tar -xzf /tmp/sc-qa-wp/core.tar.gz -C /opt/sc-qa-wordpress-core \
      --strip-components=1 --no-same-owner --no-same-permissions; \
    curl -q --fail --location --proto '=https' --proto-redir '=https' \
      --retry 2 --connect-timeout 15 --max-time 90 --silent --show-error \
      -o /tmp/sc-qa-wp/sqlite.zip https://downloads.wordpress.org/plugin/sqlite-database-integration.3.0.2.zip; \
    echo '1602e75577ad9b3a7e3e4a6a44a81b9541cdee2124d48928faf61c6fd3cd4f74  /tmp/sc-qa-wp/sqlite.zip' | sha256sum --check; \
    unzip -q /tmp/sc-qa-wp/sqlite.zip -d /opt/sc-qa-wordpress-core/wp-content/plugins; \
    cp /opt/sc-qa-wordpress-core/wp-content/plugins/sqlite-database-integration/db.copy \
      /opt/sc-qa-wordpress-core/wp-content/db.php; \
    test -f /opt/sc-qa-wordpress-core/wp-load.php; \
    test -f /opt/sc-qa-wordpress-core/wp-content/db.php; \
    rm -rf /tmp/sc-qa-wp
# Dedicated unprivileged disposable guest account; no host or production users.
RUN useradd --create-home --shell /bin/sh scqa
STOPSIGNAL SIGRTMIN+3
# Emit startup evidence to Docker logs even if the init scope fails early.
CMD ["/sbin/init", "--log-target=console", "--log-level=info"]
