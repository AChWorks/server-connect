[Unit]
Description=Server Connect independent Native and historical activation recovery
Documentation=https://github.com/AChWorks/server-connect
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/server-connect/current/bin/server-connect activation-trial-recover
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/server-connect
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# The independent Recovery Guard verifies the exact supervised sing-box
# child executable via /proc/<pid>/exe. Linux ptrace read checks require
# its capabilities to cover the managed Core's CAP_NET_RAW as well. Grant
# only the Core's existing NET_ADMIN/NET_RAW set; do not add SYS_PTRACE.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
UMask=0077
