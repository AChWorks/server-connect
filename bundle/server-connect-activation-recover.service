[Unit]
Description=Server Connect independent guarded-rule trial recovery
Documentation=https://github.com/AChWorks/server-connect
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/server-connect/current/bin/server-connect activation-trial-recover
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/server-connect /proc/sys/net/ipv4/tcp_fwmark_accept
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Debian 12 iptables-legacy nat/raw inventory uses a raw socket even for
# read-only inspection. The independent rollback must corroborate third-party
# Docker NAT, not refuse it due to its own missing capability (IRA-124 field QA).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
UMask=0077
