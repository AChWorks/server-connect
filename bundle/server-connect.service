# Server Connect managed unit; Proxy Only; owns no system routes.
# Disposable CI path-filter proof only; do not merge this comment-only PR.
[Unit]
Description=Server Connect authenticated loopback proxy (sing-box)
After=network.target
Documentation=https://github.com/AChWorks/server-connect

[Service]
Type=simple
DynamicUser=yes
LoadCredential=proxy-config:/var/lib/server-connect/runtime.json
WorkingDirectory=/opt/server-connect/current/bin
ExecStart=/opt/server-connect/current/bin/sing-box run -c /run/credentials/server-connect.service/proxy-config
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
